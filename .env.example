# Base URL of the public HomeOps recipes API (family-ops repo,
# RecipesApiFunction). The /recipes and /recipes/[slug] pages fetch from
# `${VITE_RECIPES_API_BASE}/api/recipes` and
# `${VITE_RECIPES_API_BASE}/api/recipes/{slug}` respectively.
#
# Production: the HttpApi domain output by `sam deploy` on family-ops.
#   e.g. https://abcd1234.execute-api.ap-southeast-1.amazonaws.com
# Local dev: point at `sam local start-api`'s URL (typically
#   http://127.0.0.1:3000) or a deployed-dev stack.
VITE_RECIPES_API_BASE=
